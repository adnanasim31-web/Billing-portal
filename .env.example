# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-side ONLY, never expose to the browser.
# Used for: admin user provisioning, OTP issuance, audit log writes, cross-org admin reads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MedBill RCM Suite"

# Secret used to sign/verify short-lived tokens (invitations, password reset fallback)
APP_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Email (transactional - OTP codes, invitations, password reset)
# Supabase Auth handles password reset emails natively; this SMTP config is
# used for custom OTP / invitation emails sent via a Supabase Edge Function
# or a Next.js route handler.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MedBill RCM Suite <no-reply@yourdomain.com>"

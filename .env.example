# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-side ONLY, never expose to the browser.
# Used for: admin user provisioning, OTP issuance, audit log writes, cross-org admin reads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MedBill RCM Suite"

# Secret used to sign/verify short-lived tokens (invitations, password reset fallback)
APP_SECRET=replace-with-a-long-random-string

# Optional: a dedicated hostname for the patient portal (e.g. a second
# Vercel domain/alias on this same project, such as a *.vercel.app name
# added under Project Settings -> Domains). When set, visiting "/" on that
# exact host takes patients straight to the portal instead of the staff
# app's root. Leave blank to skip this - the staff domain is unaffected
# either way. Do not include the protocol, e.g. "medbill-patient.vercel.app".
PATIENT_PORTAL_HOST=

# ---------------------------------------------------------------------------
# Email (staff + patient/provider portal invitations and notifications)
# Supabase Auth handles password reset emails natively. This SMTP config is
# used by src/lib/email.ts for the invitation emails sent from Team Members
# and the patient's Portal Access tab, plus the Provider Portal's "billing
# office replied" and "credentials expiring soon" notification emails.
# Optional: if SMTP_HOST is left blank, invite links are shown in a copyable
# dialog instead of being emailed, and the notification emails are silently
# skipped (not retried as failures) - everything else still works.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MedBill RCM Suite <no-reply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Cron (Provider Portal notifications)
# Protects /api/cron/provider-credential-expiration, which Vercel Cron hits
# daily per vercel.json. Set this to a long random string in the Vercel
# project's environment variables - Vercel automatically sends it as
# `Authorization: Bearer <value>` on cron-triggered requests, so the route
# can reject any other caller. Required for the credential-expiration email
# to run at all; leaving it unset makes every cron hit 401.
# ---------------------------------------------------------------------------
CRON_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Stripe (patient portal card payments)
# Use test-mode keys (pk_test_.../sk_test_...) from the Stripe Dashboard
# until you're ready to accept real charges - the portal's payment dialog
# shows a "Test mode" banner automatically whenever the publishable key
# starts with pk_test_. Required for the patient portal's "Pay balance"
# button to work at all - if unset, it shows a clear "not enabled yet"
# message instead of a broken card form.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# From Stripe Dashboard -> Developers -> Webhooks, after adding an endpoint
# pointed at https://yourdomain.com/api/webhooks/stripe for the
# payment_intent.succeeded and payment_intent.payment_failed events.
STRIPE_WEBHOOK_SECRET=whsec_...

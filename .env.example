# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-side ONLY, never expose to the browser.
# Used for: admin user provisioning, OTP issuance, audit log writes, cross-org admin reads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MedBill RCM Suite"

# Secret used to sign/verify short-lived tokens (invitations, password reset fallback)
APP_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Email (staff + patient portal invitations)
# Supabase Auth handles password reset emails natively. This SMTP config is
# used by src/lib/email.ts for the invitation emails sent from Team Members
# and the patient's Portal Access tab. Optional: if SMTP_HOST is left blank,
# invite links are shown in a copyable dialog instead of being emailed - the
# feature still works, it just requires manually sharing the link.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MedBill RCM Suite <no-reply@yourdomain.com>"
